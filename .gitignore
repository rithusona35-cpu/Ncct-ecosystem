# ==============================================================================
# NCCT Ecosystem - Root Git Ignore Specification
# Prevents accidental commits of secrets, local databases, and build artifacts
# ==============================================================================

# Secrets & Environment variables (DO NOT COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production
!.env.example
!.env.production.example

# Local SQLite databases
*.db
*.db-journal
*.sqlite
*.sqlite3

# Python build & runtime artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Python Virtual Environments
venv/
.venv/
env/
ENV/

# Node.js & Next.js build artifacts
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.turbo/

# Executables & Cloudflare binary
*.exe
cloudflared.exe

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Logs & temp uploads
*.log
uploads/*
!uploads/.gitkeep
