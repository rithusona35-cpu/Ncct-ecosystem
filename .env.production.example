# ==============================================================================
# NCCT Ecosystem - Production Environment Template (Neon Postgres Ready)
# Copy this file to .env.production or set these in your cloud provider.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Managed Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Neon Postgres Connection URL (Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require)
# Note: Both postgres:// and postgresql:// prefixes are automatically handled.
# sslmode=require is automatically appended for Neon and production environments.
DATABASE_URL=postgresql://neondb_owner:npg_YOUR_PASSWORD@ep-solitary-brook-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# SSL Mode requirement for cloud PostgreSQL (default: require in production)
DB_SSL_MODE=require

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT CONFIGURATION
# ------------------------------------------------------------------------------
# Generate strong keys with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=ncct-production-access-token-jwt-secret-key-super-secure-2026
JWT_REFRESH_SECRET_KEY=ncct-production-refresh-token-jwt-secret-key-super-secure-2026
SECRET_KEY=ncct-production-access-token-jwt-secret-key-super-secure-2026

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. CORS & DEPLOYED FRONTEND DOMAIN ALLOWLIST
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (e.g. deployed Vercel frontend, custom domain)
CORS_ORIGINS=https://ncct-frontend.vercel.app,https://cnet-wayne-occur-ratio.trycloudflare.com,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8000
WEB_CONCURRENCY=3
TIMEOUT=120

# ------------------------------------------------------------------------------
# 5. EXTERNAL AI & INTEGRATION APIS
# ------------------------------------------------------------------------------
# Google Gemini API key for NCCT Career Guidance AI assistant
GEMINI_API_KEY=AIzaSyDemoNCCTAssistantKey2026Secure
FALLBACK_MODE=false

# ------------------------------------------------------------------------------
# 6. CLOUDINARY FILE STORAGE (Curriculum PDFs/Videos & Verified Certificates)
# ------------------------------------------------------------------------------
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz1@ncct-cloud
